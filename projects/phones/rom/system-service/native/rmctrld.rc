# rmctrld — Remote Control Daemon
# Init script for Android init system
# Place in: system_ext/etc/init/rmctrld.rc
# OR: device/oneplus/dumpling/rmctrld.rc

service rmctrld /system_ext/bin/rmctrld
    class main
    user system
    group system graphics inet
    socket rmctrld stream 660 system system
    # onrestart restart rmctrld
    seclabel u:r:rmctrld:s0

